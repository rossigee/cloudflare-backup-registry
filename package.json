{
  "name": "cloudflare-backup-registry",
  "version": "0.5.2",
  "description": "Cloudflare Workers-based backup run registry",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "dev:test": "AUTH_USER=testuser AUTH_PASS=testpass API_TOKENS=test-api-token wrangler dev --env testing",
    "deploy:golder": "wrangler deploy --env golder -c sites/wrangler.golder.toml",
    "deploy:wardle": "wrangler deploy --env wardle -c sites/wrangler.wardle.toml",
    "deploy:timewarp": "wrangler deploy --env timewarp -c sites/wrangler.timewarp.toml",
    "deploy:all": "npm run deploy:golder && npm run deploy:wardle && npm run deploy:timewarp",
    "build": "wrangler deploy --dry-run --env golder -c sites/wrangler.golder.toml",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.3",
    "@cloudflare/workers-types": "^4.20250401.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.5",
    "wrangler": "^4.105.0"
  },
  "dependencies": {
    "jose": "^6.2.3"
  }
}
