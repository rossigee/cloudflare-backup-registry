{
  "name": "cloudflare-backup-registry",
  "version": "0.5.2",
  "description": "Cloudflare Workers-based backup run registry",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "dev:test": "AUTH_USER=testuser AUTH_PASS=testpass API_TOKENS=test-api-token wrangler dev --env testing",
    "deploy:production": "wrangler deploy --env production -c sites/wrangler.production.toml",
    "deploy:staging": "wrangler deploy --env staging -c sites/wrangler.staging.toml",
    "build": "wrangler deploy --dry-run --env production -c sites/wrangler.production.toml",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.3",
    "@cloudflare/workers-types": "^4.20250401.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.5",
    "wrangler": "^4.105.0"
  },
  "dependencies": {
    "jose": "^6.2.3"
  }
}
