# Template for site-specific environment configuration
# Copy this file and replace 'example' with your deployment name
# Example: cp sites/example.env.template sites/production.env
# Then edit with your actual values
#
# This file is sourced by .env.sh to load deployment-specific settings
# DO NOT COMMIT - Add to .gitignore

# Vault tenant path where your secrets are stored
# Your Vault path for this organization/tenant
VAULT_TENANT=my-organization-id

# OAuth2/OIDC configuration
# URL of your Keycloak/OIDC provider's realm
JWT_ISSUER=https://auth.example.com/auth/realms/my-realm

# Domain where this registry is deployed
BASE_URL=https://backups.example.com

# Your Cloudflare account ID
# Find this at https://dash.cloudflare.com/ in your account settings
CLOUDFLARE_ACCOUNT_ID=abc123def456abc123def456abc123de
